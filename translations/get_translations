#!/usr/bin/env bash

# Get script directory and determine app name
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"
APPNAME="$(basename "$PROJECT_DIR")"

set -e
cd "$SCRIPT_DIR"
shopt -s nullglob
if ! command -v tx >/dev/null; then
    echo "Error: tx is required to refresh translations." >&2
    exit 1
fi

# Prepare transifex
if [ ! -s  .tx/config ]; then
   mkdir -p .tx
   cat <<EOF > .tx/config
[main]
host = https://www.transifex.com

[o:anticapitalista:p:antix-development:r:$APPNAME]
file_filter = ./${APPNAME}_<lang>.ts
source_file = ${APPNAME}_en.ts
source_lang = en
type        = ts
minimum_perc = 25
EOF
fi

# Migrate percent checking
if [ -z "$(grep minimum_perc .tx/config)" ]; then
        echo "minimum_perc = 25" >> .tx/config
fi

# Find lupdate command in common locations
LUPDATE=""
for cmd in lupdate lupdate-qt6 /usr/lib/qt6/bin/lupdate /usr/bin/lupdate /usr/local/bin/lupdate; do
    if command -v "$cmd" >/dev/null 2>&1; then
        LUPDATE="$cmd"
        break
    fi
done

if [ -z "$LUPDATE" ]; then
    echo "Error: lupdate command not found. Please install Qt development tools."
    exit 1
fi

echo "Using lupdate: $LUPDATE"

# Stage on the same filesystem so each completed catalog can be installed
# with a rename. A failed pull or lupdate leaves the working catalogs intact.
stage=$(mktemp -d "$PROJECT_DIR/.catalogs.XXXXXX")
trap 'rm -rf -- "$stage"' EXIT
mkdir "$stage/.tx"
cp .tx/config "$stage/.tx/config"
cp "${APPNAME}_en.ts" "$stage/"
(cd "$stage" && tx pull -r "antix-development.$APPNAME" --all)
rm -f -- "$stage/${APPNAME}_en_US.ts"

catalogs=("$stage/${APPNAME}_"*.ts)
if (( ${#catalogs[@]} < 2 )); then
    echo "Error: the pull returned no translated catalogs." >&2
    exit 1
fi

sources=(../src/*.cpp ../src/*.h ../src/*.ui)
"$LUPDATE" "${sources[@]}" -ts "$stage/${APPNAME}_en.ts"

# Capture stale names before moving the staged files into place.
stale=()
for catalog in "${APPNAME}_"*.ts; do
    if [[ ! -f "$stage/$catalog" ]]; then
        stale+=("$catalog")
    fi
done
mv -f -- "${catalogs[@]}" .
if (( ${#stale[@]} )); then
    rm -f -- "${stale[@]}"
fi
